# SinricPro (required)
SINRIC_APP_KEY=your_key_here
SINRIC_APP_SECRET=your_secret_here
SINRIC_DEVICE_ID=your_id_here

# Solarman (required)
SOLARMAN_APP_ID=your_app_id
SOLARMAN_APP_SECRET=your_secret_here
SOLARMAN_EMAIL=your_email
# Prefer SOLARMAN_PASSWORD_HASH (SHA-256 hex digest) so your plaintext password
# never sits on the phone. Generate with:
#   python -m solar_bridge --hash-password
SOLARMAN_PASSWORD_HASH=your_sha256_password_hash_here
# Optional fallback if you do not use SOLARMAN_PASSWORD_HASH:
# SOLARMAN_PASSWORD=your_password
INVERTER_SN=your_serial_number

# Monitoring (optional)
HEALTHCHECKS_URL=

# Reliability & Runtime Tuning (optional, defaults shown)
# POLL_INTERVAL_SECONDS=300
# HEARTBEAT_INTERVAL_SECONDS=1800
# HEALTH_CHECK_INTERVAL_SECONDS=30
# KEEPALIVE_INTERVAL_SECONDS=60
# MAX_OFFLINE_SECONDS=120
# RECYCLE_INTERVAL_HOURS=12
# TOKEN_REFRESH_HOURS=12
# LOG_FILE=logs/bridge.log
# STATUS_FILE=status.json
